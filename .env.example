# =============================================================
# 智评 · Insight —— 环境变量样例(复制为 .env 后按需修改)
# 可放在仓库根目录或 backend/ 下(config.py 会依次探测)
# =============================================================

# ---------- 评阅大模型(国产可替换; 内置引擎开箱即用) ----------
# provider: builtin(内置本地引擎, 默认) | deepseek | qwen(通义) | zhipu(智谱)
# 保持默认(不填/填 builtin)时, 主观题/口语题由内置确定性引擎完成判分与评语,
# 全流程无需外部模型 Key 即可离线跑通。
GRADE_LLM_PROVIDER=builtin
# 填真实国产模型 Key 即切换为“确定性判分 + 大模型复核/评语”协同模式
GRADE_LLM_API_KEY=
GRADE_LLM_BASE_URL=
GRADE_LLM_MODEL=

# ---------- 评阅默认阈值(单题可在 scoring_policy 覆盖) ----------
# 置信度低于该值 → 强制转人工复核
REVIEW_THRESHOLD=0.78
# 客观题是否自动放行(确定性判分, 命中率 100%)
AUTO_RELEASE_OBJECTIVE=true

# ---------- 数据库 ----------
# 默认 sqlite 文件库: backend/data/app.db
# DATABASE_URL=sqlite:///...

# ---------- 启动行为 ----------
# 首次启动若数据库为空则自动注入初始化示例数据(大学物理课程/题目/答卷, 并完成评阅)
AUTO_SEED_ON_START=true

# ---------- 认证(生产环境务必替换) ----------
SECRET_KEY=insight-dev-secret-change-me
TOKEN_TTL_HOURS=24
